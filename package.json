{
  "name": "ai-uc-rpa-guidance-fe",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --use-strict ./src/index.js",
    "start:dev": "NODE_ENV=development run-p build:watch server:watch",
    "server:watch": "mkdir -p .public && node --env-file-if-exists=.env --use-strict --watch-preserve-output --watch-path=src/common --watch-path=src/config --watch-path=src/constants --watch-path=src/filters --watch-path=src/health-probe --watch-path=src/infra --watch-path=src/models --watch-path=src/pages --watch-path=src/schemas --watch-path=src/server --watch-path=src/services --watch-path=src/index.js --watch-path=.public ./src/index.js",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "TZ=UTC run-s lint build test:js",
    "test:js": "TZ=UTC vitest run --coverage"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.2",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.1",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.1.0",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "date-fns": "4.4.0",
    "flatted": "3.4.4",
    "global-agent": "4.1.3",
    "govuk-frontend": "6.6.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "6.0.0",
    "joi": "18.2.9",
    "lodash": "4.18.1",
    "marked": "18.1.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "sanitize-html": "2.18.1",
    "semver": "7.8.4",
    "undici": "8.12.2",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.1",
    "cssnano": "9.8.0",
    "cssnano-preset-default": "9.8.0",
    "eslint": "9.39.2",
    "jsdom": "30.1.3",
    "neostandard": "0.14.1",
    "nock": "15.0.1",
    "npm-run-all2": "9.0.3",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "8.2.1",
    "sass-embedded": "1.105.1",
    "sass-loader": "17.0.1",
    "sharp": "0.35.5",
    "source-map-loader": "5.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-gds": "3.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "joi": "18.2.9",
    "blankie": {
      "@hapi/joi": "npm:joi@18.2.9"
    },
    "nunjucks": {
      "chokidar": "5.0.0"
    }
  }
}
