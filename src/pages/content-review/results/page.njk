{% extends "common/layout.njk" %}

{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}

{% set page = 'content-review' %}

{% block content %}
  <div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">

      {# ── Notification banner — the final usability test ──────────────── #}
      {% if usability.verdict == 'yes' %}
        {{ govukNotificationBanner({
          type: "success",
          titleText: "Passes the usability test",
          text: "A user can follow this guidance under pressure and get it right first time."
        }) }}
      {% elif usability.verdict == 'partly' %}
        {{ govukNotificationBanner({
          titleText: "Partly passes the usability test",
          text: "Improvements are needed before a user can reliably get it right first time."
        }) }}
      {% else %}
        {{ govukNotificationBanner({
          type: "important",
          titleText: "Does not pass the usability test",
          text: "A user cannot complete the task correctly with this guidance. Resolve the findings below.",
          attributes: { role: "alert" }
        }) }}
      {% endif %}

      {# ── Page heading + task and user context ────────────────────────── #}
      <span class="govuk-caption-m" style="color: #505a5f">Guidance content review</span>
      <h1 class="govuk-heading-l">{{ documentTitle }}</h1>

      {% set taskContextHtml %}
        {{ govukSummaryList({ rows: taskContextRows }) }}
      {% endset %}
      {{ govukDetails({
        summaryText: "Task and user context",
        html: taskContextHtml
      }) }}

      {# ── Findings and principle ratings, in separate tabs ────────────── #}
      {% set findingsPanelHtml %}
        <h2 class="govuk-heading-m">Findings ({{ totalFindings }})</h2>

        {% if severityRows | length %}
          <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-third">
              {{ govukSummaryList({ card: { title: { text: "Issue overview" } }, rows: severityRows }) }}
            </div>
          </div>
        {% endif %}

        {% if importantItems | length %}
          <h3 class="govuk-heading-s">Important to fix</h3>
          {{ govukTaskList({ idPrefix: "important", items: importantItems }) }}
        {% endif %}

        {% if suggestionItems | length %}
          <h3 class="govuk-heading-s govuk-!-margin-top-6">Suggestions</h3>
          {{ govukTaskList({ idPrefix: "suggestions", items: suggestionItems }) }}
        {% endif %}

        {% if not totalFindings %}
          <p class="govuk-body">No findings were identified.</p>
        {% endif %}
      {% endset %}

      {% set ratingsPanelHtml %}
        <h2 class="govuk-heading-m">Principle ratings</h2>
        <p class="govuk-body-s">The evidence behind each rating is in the findings.</p>
        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header govuk-!-width-one-half">Principle</th>
              <th scope="col" class="govuk-table__header">Rating</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for rating in principleRatings %}
              <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">{{ rating.label }}</th>
                <td class="govuk-table__cell">
                  <strong class="govuk-tag {{ rating.tag.classes }}">{{ rating.tag.text }}</strong>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endset %}

      {{ govukTabs({
        items: [
          {
            label: "Findings (" + totalFindings + ")",
            id: "findings",
            panel: { html: findingsPanelHtml }
          },
          {
            label: "Principle ratings",
            id: "principle-ratings",
            panel: { html: ratingsPanelHtml }
          }
        ]
      }) }}

      {# ── What the guidance does well (secondary, collapsed) ──────────── #}
      {% if goodPoints | length %}
        <details class="govuk-details govuk-!-margin-top-6">
          <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">What the guidance does well</span>
          </summary>
          <div class="govuk-details__text">
            {% for point in goodPoints %}
              <h3 class="govuk-heading-s">{{ point.label }}</h3>
              <div class="govuk-inset-text">{{ point.quote }}</div>
              <p class="govuk-body">{{ point.comment }}</p>
            {% endfor %}
          </div>
        </details>
      {% endif %}

      {# ── Token usage ─────────────────────────────────────────────────── #}
      {% if usage %}
        <p class="govuk-body-s" style="color: #505a5f; margin-top: 40px">
          Token usage — input: {{ usage.input_tokens }} · output: {{ usage.output_tokens }}
        </p>
      {% endif %}

      <p class="govuk-body govuk-!-margin-top-6">
        <a class="govuk-link" href="/content-review">Start another content review</a>
      </p>

    </main>
  </div>
{% endblock %}
