{% extends "common/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% set pageTitle = 'Start a quality check' %}
{% set page = 'quality-checks' %}

{% block content %}
  <div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">

      {% if errorMessage %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: errorMessage, href: "#documentId" }]
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">Start a quality check</h1>

      {% if hasGuides %}
        <form method="post" action="/proof-of-concept/quality-checks/start">
          <input type="hidden" name="_csrf" value="{{ csrf }}">

          {{ govukSelect({
            id: "documentId",
            name: "documentId",
            label: {
              text: "Select a document",
              classes: "govuk-label--m"
            },
            items: selectItems,
            errorMessage: showSelectError and { text: errorMessage }
          }) }}

          {{ govukButton({
            text: "Start quality check"
          }) }}
        </form>
      {% else %}
        <p class="govuk-body">
          No prototype guides are available to check. Upload prototype
          guides before running a quality check.
        </p>
        <a class="govuk-link" href="/prototype-guides/upload">
          Upload prototype guides
        </a>
      {% endif %}

    </main>
  </div>
{% endblock %}
