{% extends "common/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% import "components/toc-nav/macro.njk" as tocNav %}

{% block content %}
  <div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content" role="main">

      <span class="govuk-caption-l">Prototype guide</span>
      <h1 class="govuk-heading-xl">{{ title }}</h1>

      <div class="app-guide-view-toggle" role="group" aria-label="Guide format">
        {% for option in views %}
          <a class="govuk-link app-guide-view-toggle__option" href="{{ option.href }}"{% if option.isCurrent %} aria-current="true"{% endif %}>
            {{- option.text -}}
          </a>
        {% endfor %}
      </div>

      {# Finds keywords in this guide only, so the browser's find shortcut
         comes here (client/javascripts/keyword-search/highlight.js). It stays
         in view as the reader scrolls, to show what they are looking for. #}
      <form class="app-keyword-search" role="search" data-module="keyword-search">
        <div class="app-keyword-search__bar">
          {{ govukInput({
            id: "keywords",
            name: "keywords",
            type: "search",
            value: keywords,
            label: {
              text: "Search for keywords in this document",
              classes: "govuk-visually-hidden"
            },
            attributes: {
              placeholder: "Search for keywords in this document",
              "data-module": "search-shortcut"
            },
            formGroup: { classes: "app-keyword-search__field" }
          }) }}
          {{ govukButton({ text: "Search", classes: "app-keyword-search__button" }) }}
        </div>
        <p class="govuk-body-s app-keyword-search__status" role="status" data-keyword-search-status></p>
      </form>

      <div class="govuk-grid-row app-guide-layout">
        <div class="govuk-grid-column-one-third">
          {# The whole outline, at every depth. Reading the whole guide, the
             section in view is highlighted as the reader scrolls
             (client/javascripts/guide-outline/highlight.js); in the stepper,
             the step's own sections are, and the outline scrolls to them. #}
          <nav class="app-toc app-toc--full" aria-labelledby="guide-outline-title" data-module="{{ 'guide-step-outline' if step else 'guide-outline' }}">
            <h2 class="govuk-heading-s app-toc__title" id="guide-outline-title">Contents</h2>
            {{ tocNav.tocList(outline) }}
          </nav>
        </div>

        <div class="govuk-grid-column-two-thirds">
          {% if step %}
            <p class="govuk-caption-m">Step {{ step.number }} of {{ step.total }}</p>
          {% endif %}

          {# Next first, and above the step, so it stays in the same place as
             the reader steps through the guide. #}
          {% if step and (step.previous or step.next) %}
            <nav class="govuk-pagination govuk-pagination--block" aria-label="Steps">
              {% if step.next %}
                <div class="govuk-pagination__next">
                  <a class="govuk-link govuk-pagination__link" href="{{ step.next.href }}" rel="next">
                    <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> step</span></span>
                    <span class="govuk-pagination__link-label">{{ step.next.label }}</span>
                    <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                      <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z"></path>
                    </svg>
                  </a>
                </div>
              {% endif %}
              {% if step.previous %}
                <div class="govuk-pagination__prev">
                  <a class="govuk-link govuk-pagination__link" href="{{ step.previous.href }}" rel="prev">
                    <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                      <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                    </svg>
                    <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> step</span></span>
                    <span class="govuk-pagination__link-label">{{ step.previous.label }}</span>
                  </a>
                </div>
              {% endif %}
            </nav>
          {% endif %}

          <div class="app-guidance-content">
            {% if introductionHtml %}
              {{ introductionHtml | safe }}
            {% endif %}
            {% for section in sections %}
              <section class="app-guide-section" id="{{ section.anchor }}">
                {{ section.html | safe }}
              </section>
            {% endfor %}
          </div>

        </div>
      </div>
    </main>
  </div>
{% endblock %}
